# Variables de entorno para Chatenizer

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-app-id
FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456789

# Otros servicios (si se añaden en el futuro)
# API_URL=
# SOCKET_SERVER_URL=

# Variables de entorno para diferentes ambientes
ENVIRONMENT=development
DEBUG=true